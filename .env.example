# Database Config
DB_NAME=food_delivery
DB_USER=food_user
DB_PASSWORD=food_password
DB_PORT=5433

# Ports
ADMINER_PORT=8081
BACKEND_PORT=8001
FRONTEND_PORT=3001

# Laravel Specific
APP_ENV=local
APP_DEBUG=true
APP_KEY= # Run "php artisan key:generate" in the backend directory to generate this key
APP_URL=http://localhost:8001

# Cloudinary Credentials (REQUIRED for image/payment proof uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Next.js Config
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1
NEXT_PUBLIC_BACKEND_URL=http://localhost:8001
NEXT_PUBLIC_WS_URL=ws://localhost:8001

SANCTUM_STATEFUL_DOMAINS=localhost:3001 
SESSION_DOMAIN=localhost
