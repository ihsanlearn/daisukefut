# Next.js API & Backend Routes
# Local defaults point to the Laravel local container/server.
# In production:
# NEXT_PUBLIC_API_URL=https://daisukefut.onrender.com/api
# NEXT_PUBLIC_BACKEND_URL=https://daisukefut.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8001/api
NEXT_PUBLIC_BACKEND_URL=http://localhost:8001

# WebSocket Configuration (optional)
# Local: ws://localhost:8001
# Production: wss://daisukefut.onrender.com
NEXT_PUBLIC_WS_URL=ws://localhost:8001

# Midtrans Client Key
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
